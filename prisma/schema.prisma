// Prisma Schema for RealtyCRM Pro
// Azure SQL Database compatible

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ============================================
// Core Models
// ============================================

model Tenant {
  id               String    @id @default(uuid())
  name             String
  subscriptionTier String    @default("starter") // starter, pro, enterprise
  maxUsers         Int       @default(1)
  maxListings      Int       @default(25)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  users       User[]
  properties  Property[]
  leads       Lead[]
  showings    Showing[]
  invitations Invitation[]

  @@map("tenants")
}

model User {
  id               String    @id @default(uuid())
  tenantId         String
  email            String    @unique
  passwordHash     String
  firstName        String
  lastName         String
  phone            String?
  profileImageUrl  String?
  role             UserRole  @default(AGENT)
  licenseNumber    String?
  bio              String?
  timezone         String    @default("America/Chicago")
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  resetToken       String?   // Hashed password reset token
  resetTokenExpiry DateTime? // Expiry time for reset token
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  tenant               Tenant             @relation(fields: [tenantId], references: [id])
  properties           Property[]
  leads                Lead[]             @relation("AssignedAgent")
  showings             Showing[]
  communications       Communication[]
  activities           ActivityLog[]
  templates            MessageTemplate[]
  sentInvitations      Invitation[]
  smsConversations     SMSConversation[]  @relation("SMSAssignedAgent")
  sentSMSMessages      SMSMessage[]       @relation("SMSSentByUser")
  aiInteractions       AIInteractionLog[] @relation("AIInteractionUser")

  @@index([tenantId])
  @@index([email])
  @@map("users")
}

enum UserRole {
  SELLER
  AGENT
  MANAGER
  ADMIN
}

// ============================================
// Property Management
// ============================================

model Property {
  id           String         @id @default(uuid())
  tenantId     String
  userId       String
  address      String
  city         String
  state        String         @db.VarChar(2)
  zipCode      String         @db.VarChar(10)
  bedrooms     Int
  bathrooms    Float
  sqft         Int
  price        Decimal        @db.Decimal(12, 2)
  status       PropertyStatus @default(FOR_SALE)
  description  String?        @db.Text
  mlsNumber    String?
  yearBuilt    Int?
  lotSize      String?
  propertyType PropertyType   @default(SINGLE_FAMILY)
  photoUrls    String?        @db.Text // JSON array stored as text
  features     String?        @db.Text // JSON array stored as text
  listingDate  DateTime       @default(now())
  soldDate     DateTime?
  soldPrice    Decimal?       @db.Decimal(12, 2)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Relations
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  user      User       @relation(fields: [userId], references: [id])
  leads     Lead[]
  showings  Showing[]
  documents Document[]

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@map("properties")
}

enum PropertyStatus {
  FOR_SALE
  UNDER_CONTRACT
  CLOSED
  OFF_MARKET
}

enum PropertyType {
  SINGLE_FAMILY
  CONDO
  TOWNHOUSE
  MULTI_FAMILY
  LAND
  COMMERCIAL
}

// ============================================
// Lead Management
// ============================================

model Lead {
  id                   String     @id @default(uuid())
  tenantId             String
  propertyId           String?
  assignedAgentId      String?
  firstName            String
  lastName             String
  email                String?
  phone                String?
  source               LeadSource @default(WEBSITE)
  aiScore              Int        @default(0) // 0-100
  status               LeadStatus @default(NEW)
  interestedProperties String?    @db.Text // JSON array of property IDs
  notes                String?    @db.Text
  lastActivityAt       DateTime   @default(now())
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  // Relations
  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  property         Property?          @relation(fields: [propertyId], references: [id])
  assignedAgent    User?              @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  showings         Showing[]
  communications   Communication[]
  documents        Document[]
  smsConversations SMSConversation[]
  aiInteractions   AIInteractionLog[]

  @@index([tenantId])
  @@index([propertyId])
  @@index([assignedAgentId])
  @@index([status])
  @@index([aiScore])
  @@map("leads")
}

enum LeadSource {
  WEBSITE
  FACEBOOK_AD
  GOOGLE_AD
  REFERRAL
  IMPORT
  MANUAL
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  SHOWING_SCHEDULED
  OFFER_RECEIVED
  CLOSED
  LOST
}

// ============================================
// Showings & Calendar
// ============================================

model Showing {
  id              String        @id @default(uuid())
  tenantId        String
  propertyId      String
  leadId          String
  agentId         String
  scheduledAt     DateTime
  durationMinutes Int           @default(30)
  status          ShowingStatus @default(SCHEDULED)
  feedback        String?       @db.Text
  buyerInterest   Int? // 0-100 rating
  notes           String?       @db.Text
  reminderSentAt  DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
  lead     Lead     @relation(fields: [leadId], references: [id])
  agent    User     @relation(fields: [agentId], references: [id])

  @@index([tenantId])
  @@index([propertyId])
  @@index([leadId])
  @@index([agentId])
  @@index([scheduledAt])
  @@map("showings")
}

enum ShowingStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ============================================
// Communications
// ============================================

model Communication {
  id         String            @id @default(uuid())
  tenantId   String
  leadId     String
  userId     String
  type       CommunicationType
  subject    String?
  body       String            @db.Text
  templateId String?
  sentAt     DateTime          @default(now())
  openedAt   DateTime?
  clickedAt  DateTime?
  status     String            @default("sent")

  // Relations
  lead     Lead              @relation(fields: [leadId], references: [id])
  user     User              @relation(fields: [userId], references: [id])
  template MessageTemplate?  @relation(fields: [templateId], references: [id])

  @@index([tenantId])
  @@index([leadId])
  @@index([userId])
  @@map("communications")
}

enum CommunicationType {
  EMAIL
  SMS
  CALL
}

model MessageTemplate {
  id        String            @id @default(uuid())
  userId    String
  name      String
  subject   String?
  body      String            @db.Text
  type      CommunicationType
  isDefault Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  // Relations
  user           User            @relation(fields: [userId], references: [id])
  communications Communication[]

  @@index([userId])
  @@map("message_templates")
}

// ============================================
// Documents
// ============================================

model Document {
  id           String       @id @default(uuid())
  tenantId     String
  propertyId   String?
  leadId       String?
  uploadedById String
  documentType DocumentType
  fileName     String
  fileUrl      String
  fileSize     Int?
  createdAt    DateTime     @default(now())

  // Relations
  property Property? @relation(fields: [propertyId], references: [id])
  lead     Lead?     @relation(fields: [leadId], references: [id])

  @@index([tenantId])
  @@index([propertyId])
  @@index([leadId])
  @@map("documents")
}

enum DocumentType {
  CONTRACT
  INSPECTION
  DISCLOSURE
  OFFER
  APPRAISAL
  SURVEY
  HOA
  OTHER
}

// ============================================
// Team Invitations
// ============================================

model Invitation {
  id        String           @id @default(uuid())
  tenantId  String
  email     String
  role      UserRole         @default(AGENT)
  token     String           @unique // Hashed invitation token
  status    InvitationStatus @default(PENDING)
  invitedBy String
  expiresAt DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Relations
  tenant  Tenant @relation(fields: [tenantId], references: [id])
  inviter User   @relation(fields: [invitedBy], references: [id])

  @@index([tenantId])
  @@index([email])
  @@index([token])
  @@map("invitations")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

// ============================================
// Activity & Audit Log
// ============================================

model ActivityLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String
  entityType String // 'lead', 'property', 'showing', etc.
  entityId   String
  action     String // 'created', 'updated', 'status_changed', etc.
  details    String?  @db.Text // JSON details
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

// ============================================
// SMS Conversations
// ============================================

model SMSConversation {
  id                 String                  @id @default(uuid())
  tenantId           String
  leadId             String
  assignedAgentId    String?
  phoneNumber        String                  @db.VarChar(20) // Lead's phone number (E.164 format)
  twilioPhoneNumber  String?                 @db.VarChar(20) // Twilio number used for this conversation
  status             SMSConversationStatus   @default(ACTIVE)
  lastMessageAt      DateTime?
  lastMessagePreview String?                 @db.VarChar(160) // Preview of last message
  unreadCount        Int                     @default(0)
  isAIEnabled        Boolean                 @default(true) // Whether AI auto-responses are enabled
  aiPersonality      String?                 @db.VarChar(50) // AI personality/tone setting
  metadata           String?                 @db.Text // JSON metadata (tags, custom fields, etc.)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  // Relations
  lead          Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedAgent User?         @relation("SMSAssignedAgent", fields: [assignedAgentId], references: [id])
  messages      SMSMessage[]
  aiLogs        AIInteractionLog[]

  @@unique([tenantId, phoneNumber]) // One conversation per phone number per tenant
  @@index([tenantId])
  @@index([leadId])
  @@index([assignedAgentId])
  @@index([status])
  @@index([lastMessageAt])
  @@index([phoneNumber])
  @@map("sms_conversations")
}

enum SMSConversationStatus {
  ACTIVE
  PAUSED        // Temporarily paused (e.g., awaiting human review)
  CLOSED        // Conversation ended
  OPTED_OUT     // Lead opted out of SMS
  BLOCKED       // Blocked by system or agent
}

model SMSMessage {
  id               String           @id @default(uuid())
  tenantId         String
  conversationId   String
  direction        SMSDirection
  fromNumber       String           @db.VarChar(20)
  toNumber         String           @db.VarChar(20)
  body             String           @db.Text
  mediaUrls        String?          @db.Text // JSON array of media URLs (MMS)
  status           SMSMessageStatus @default(QUEUED)
  twilioSid        String?          @db.VarChar(50) // Twilio message SID for tracking
  errorCode        String?          @db.VarChar(20) // Twilio error code if failed
  errorMessage     String?          @db.VarChar(255)
  isAIGenerated    Boolean          @default(false)
  aiInteractionId  String?          // Link to AI interaction that generated this message
  sentByUserId     String?          // Agent who sent (for outbound manual messages)
  segmentCount     Int              @default(1) // Number of SMS segments
  price            Decimal?         @db.Decimal(10, 5) // Cost from Twilio
  sentAt           DateTime?
  deliveredAt      DateTime?
  readAt           DateTime?
  createdAt        DateTime         @default(now())

  // Relations
  conversation  SMSConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  aiInteraction AIInteractionLog? @relation(fields: [aiInteractionId], references: [id])
  sentByUser    User?             @relation("SMSSentByUser", fields: [sentByUserId], references: [id])

  @@index([tenantId])
  @@index([conversationId])
  @@index([twilioSid])
  @@index([status])
  @@index([createdAt])
  @@index([sentByUserId])
  @@map("sms_messages")
}

enum SMSDirection {
  INBOUND   // Message from lead to agent
  OUTBOUND  // Message from agent/AI to lead
}

enum SMSMessageStatus {
  QUEUED      // Waiting to be sent
  SENDING     // Currently being sent
  SENT        // Sent to carrier
  DELIVERED   // Delivered to device
  READ        // Read by recipient (if supported)
  FAILED      // Failed to send
  UNDELIVERED // Could not be delivered
}

// ============================================
// AI Interaction Logs
// ============================================

model AIInteractionLog {
  id                String              @id @default(uuid())
  tenantId          String
  conversationId    String?             // SMS conversation this relates to
  leadId            String?             // Lead this interaction relates to
  userId            String?             // User who triggered the interaction (if applicable)
  interactionType   AIInteractionType
  modelName         String              @db.VarChar(50) // e.g., 'gpt-4', 'claude-3', 'gpt-3.5-turbo'
  modelProvider     String              @db.VarChar(30) // e.g., 'openai', 'anthropic', 'azure'
  promptTokens      Int                 @default(0)
  completionTokens  Int                 @default(0)
  totalTokens       Int                 @default(0)
  promptText        String?             @db.Text // The prompt sent to the AI
  responseText      String?             @db.Text // The response from the AI
  systemPrompt      String?             @db.Text // System prompt used
  temperature       Float?              // Temperature setting used
  status            AIInteractionStatus @default(PENDING)
  latencyMs         Int?                // Response time in milliseconds
  cost              Decimal?            @db.Decimal(10, 6) // Estimated cost
  errorMessage      String?             @db.Text
  metadata          String?             @db.Text // JSON metadata (function calls, tool usage, etc.)
  feedbackRating    Int?                // User feedback rating (1-5)
  feedbackComment   String?             @db.Text // User feedback comment
  wasEdited         Boolean             @default(false) // Whether the AI response was edited before sending
  editedText        String?             @db.Text // The edited version if wasEdited is true
  createdAt         DateTime            @default(now())
  completedAt       DateTime?

  // Relations
  conversation SMSConversation? @relation(fields: [conversationId], references: [id])
  lead         Lead?            @relation(fields: [leadId], references: [id])
  user         User?            @relation("AIInteractionUser", fields: [userId], references: [id])
  messages     SMSMessage[]     // Messages generated from this interaction

  @@index([tenantId])
  @@index([conversationId])
  @@index([leadId])
  @@index([userId])
  @@index([interactionType])
  @@index([status])
  @@index([createdAt])
  @@index([modelName])
  @@map("ai_interaction_logs")
}

enum AIInteractionType {
  SMS_RESPONSE       // AI-generated SMS response
  LEAD_SCORING       // AI-powered lead scoring
  SENTIMENT_ANALYSIS // Sentiment analysis of messages
  SUMMARY            // Conversation/lead summary generation
  PROPERTY_MATCH     // AI property matching for leads
  FOLLOW_UP_SUGGEST  // AI-suggested follow-up actions
  TRANSLATION        // Message translation
  CUSTOM             // Custom AI interaction
}

enum AIInteractionStatus {
  PENDING     // Waiting to be processed
  PROCESSING  // Currently being processed
  COMPLETED   // Successfully completed
  FAILED      // Failed with error
  CANCELLED   // Cancelled by user/system
}
