# RealtyCRM Pro - Environment Variables
# Copy this file to .env.local and fill in your values

# Database (Azure SQL Database)
DATABASE_URL="sqlserver://your-server.database.windows.net:1433;database=realtycrm;user=your-username;password=your-password;encrypt=true;trustServerCertificate=false"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Azure Blob Storage (for images/documents)
AZURE_STORAGE_CONNECTION_STRING="your-azure-storage-connection-string"
AZURE_STORAGE_CONTAINER_NAME="realty-assets"

# Email Service (SendGrid)
SENDGRID_API_KEY="your-sendgrid-api-key"
EMAIL_FROM="noreply@yourrealtycrmapp.com"

# SMS Service (Twilio)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+15551234567"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Azure Application Insights (optional, for monitoring)
APPLICATIONINSIGHTS_CONNECTION_STRING="your-app-insights-connection-string"

# MLS Integration (optional)
MLS_API_KEY="your-mls-api-key"
MLS_API_URL="https://api.mlsservice.com"
